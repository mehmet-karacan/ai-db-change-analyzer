{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DB Change Analyzer UnitResponse 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary_tr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "summary_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 1,
      "maxItems": 64
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "interpretation",
              "possible_impact",
              "recommended_check",
              "uncertainty"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "risk": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "source_backed_inference",
              "hypothesis"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "kind",
          "claim",
          "risk",
          "evidence_level",
          "evidence_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "code",
          "detail",
          "evidence_ids"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "unit_id",
    "summary_tr",
    "summary_evidence_ids",
    "findings",
    "limitations"
  ]
}
