        "side": {
          "type": "string",
          "enum": [
            "base",
            "target",
            "both",
            "none"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
