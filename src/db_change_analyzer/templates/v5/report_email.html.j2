<body bgcolor="#F4F0EA" style="margin:0;padding:0;background-color:#F4F0EA;color:#24211F;font-family:Arial,Helvetica,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;">{{ preheader }}</div>
<table bgcolor="#F4F0EA" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;background-color:#F4F0EA;border-collapse:collapse;" width="100%">
<tr><td align="center" class="outer-pad" style="padding:28px 12px;">
<!--[if mso]><table role="presentation" width="760" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table bgcolor="#FFFEFC" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;max-width:760px;background-color:#FFFEFC;border-collapse:collapse;" width="100%"><tr><td bgcolor="#A84426" height="5" style="height:5px;line-height:5px;font-size:0;background-color:#A84426;"> </td></tr>
<tr><td class="px" style="padding:22px 34px;border-bottom:1px solid #D7CCC1;">
<table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;border-collapse:collapse;" width="100%"><tr>
<td align="left" class="top-left" style="font-size:14px;line-height:21px;font-weight:bold;letter-spacing:1px;color:#A84426;">AI DB CHANGE ANALYZER</td>
<td align="right" class="top-right" style="font-size:13px;line-height:20px;color:#5F5954;">Oracle DDL incelemesi<br/>{{ report_date }}</td>
</tr></table>
</td></tr>
{% if synthetic %}<tr><td bgcolor="#F3EEE7" class="px" style="padding:12px 34px;background-color:#F3EEE7;font-size:14px;line-height:21px;color:#5F5954;">
<strong style="color:#24211F;">Tasarım örneği.</strong> Nesneler, değerler, AI yorumları ve süreler sentetiktir. Gerçek model çağrısı yapılmadı.
</td></tr>{% endif %}
{% include 'components/summary.html.j2' %}
{% include 'components/object_list.html.j2' %}
{% for obj in detail_objects %}{% include obj.renderer %}{% endfor %}
{% if artifact_notices %}<tr><td class="px" style="padding:8px 34px 24px;"><h2 style="font-size:21px;color:#24211F;">Çözümlenemeyen kaynak kayıtları</h2>{% for notice in artifact_notices %}<p style="font-size:14px;line-height:23px;color:#5F5954;"><strong>{{ notice.path_display }}:</strong> {{ notice.detail_tr }}</p>{% endfor %}</td></tr>{% endif %}
{% if critical_notes %}<tr><td class="px" style="padding:8px 34px 20px;font-size:14px;line-height:23px;color:#24211F;"><strong>Ayrıntısı kısaltılan sınırlı kayıtlar</strong>{% for note in critical_notes %}<p style="margin:8px 0;">{{ note }}</p>{% endfor %}</td></tr>{% endif %}
{% if coverage_notes %}<tr><td class="px" style="padding:8px 34px 20px;font-size:14px;line-height:23px;color:#5F5954;"><strong>Karşılaştırmanın kapsam sınırları</strong>{% for note in coverage_notes %}<p style="margin:8px 0;">{{ note }}</p>{% endfor %}</td></tr>{% endif %}
{% include 'components/analysis_record.html.j2' %}
{% include 'components/comparison_info.html.j2' %}
{% set in_object = false %}{% include 'components/scope_notes.html.j2' %}
<tr><td class="px" style="padding:17px 34px;border-top:1px solid #D7CCC1;font-size:13px;line-height:21px;color:#5F5954;">AI DB Change Analyzer<br/>{% if synthetic %}V5 sentetik tasarım incelemesi; gönderilmedi.{% else %}Git snapshot tabanlı kaynak analizi.{% endif %}</td></tr></table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table>
</body>
</html>