<body bgcolor="#F2F5F8" style="margin:0;padding:0;background-color:#F2F5F8;color:#18283A;font-family:Arial,Helvetica,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;">{{ preheader }}</div>
<table bgcolor="#F2F5F8" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;background-color:#F2F5F8;border-collapse:collapse;" width="100%">
<tr><td align="center" class="outer-pad" style="padding:28px 12px;">
<!--[if mso]><table role="presentation" width="760" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table bgcolor="#FFFFFF" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;max-width:760px;background-color:#FFFFFF;border-collapse:collapse;" width="100%"><tr><td bgcolor="#E92231" height="5" style="height:5px;line-height:5px;font-size:0;background-color:#E92231;"> </td></tr>
<tr><td bgcolor="#0B2239" class="px" style="padding:22px 34px;border-bottom:1px solid #163B5C;background-color:#0B2239;">
<table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;border-collapse:collapse;" width="100%"><tr>
<td align="left" class="top-left" style="font-size:14px;line-height:21px;font-weight:bold;letter-spacing:.7px;color:#FFFFFF;"><img src="cid:innova-logo" alt="İnnova" width="145" style="display:block;width:145px;height:auto;border:0;"/><span style="display:block;margin-top:13px;font-size:12px;line-height:18px;letter-spacing:1.5px;color:#78D5F5;">VERİTABANI DEĞİŞİKLİK ANALİZİ</span></td>
<td align="right" class="top-right" style="font-size:13px;line-height:20px;color:#D9E6F1;">Oracle DDL incelemesi<br/>{{ report_date }}</td>
</tr></table>
</td></tr>
{% if synthetic %}<tr><td bgcolor="#EAF4FA" class="px" style="padding:12px 34px;background-color:#EAF4FA;font-size:14px;line-height:21px;color:#36556E;">
<strong style="color:#0B2239;">Önizleme.</strong> Bu içerik, mail tasarımını göstermek için hazırlanmıştır; gönderim ve canlı veritabanı doğrulaması yapılmadı.
</td></tr>{% endif %}
{% include 'components/summary.html.j2' %}
{% include 'components/object_list.html.j2' %}
{% for obj in detail_objects %}{% include obj.renderer %}{% endfor %}
{% if artifact_notices %}<tr><td class="px" style="padding:8px 34px 24px;"><h2 style="font-size:21px;color:#24211F;">Çözümlenemeyen kaynak kayıtları</h2>{% for notice in artifact_notices %}<p style="font-size:14px;line-height:23px;color:#5F5954;"><strong>{{ notice.path_display }}:</strong> {{ notice.detail_tr }}</p>{% endfor %}</td></tr>{% endif %}
{% if critical_notes %}<tr><td class="px" style="padding:8px 34px 20px;font-size:14px;line-height:23px;color:#24211F;"><strong>Ayrıntısı kısaltılan sınırlı kayıtlar</strong>{% for note in critical_notes %}<p style="margin:8px 0;">{{ note }}</p>{% endfor %}</td></tr>{% endif %}
{% if coverage_notes %}<tr><td class="px" style="padding:8px 34px 20px;font-size:14px;line-height:23px;color:#5F5954;"><strong>Karşılaştırmanın kapsam sınırları</strong>{% for note in coverage_notes %}<p style="margin:8px 0;">{{ note }}</p>{% endfor %}</td></tr>{% endif %}
{% include 'components/analysis_record.html.j2' %}
{% include 'components/comparison_info.html.j2' %}
{% set in_object = false %}{% include 'components/scope_notes.html.j2' %}
<tr><td bgcolor="#F2F5F8" class="px" style="padding:17px 34px;border-top:1px solid #D8E0E8;background-color:#F2F5F8;font-size:13px;line-height:21px;color:#5C6B7A;"><strong style="color:#0B2239;">İnnova · Veritabanı Değişiklik Analizi</strong><br/>{% if synthetic %}Tasarım önizlemesi.{% else %}Git snapshot tabanlı kaynak analizi.{% endif %}</td></tr></table>
