<style type="text/css">
html,body{margin:0!important;padding:0!important;width:100%!important}
body,table,td,th,p,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table,td,th{mso-table-lspace:0pt;mso-table-rspace:0pt}
a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important}
a:focus{outline:2px solid #A84426;outline-offset:3px}
@media only screen and (max-width:600px){
.outer-pad{padding:0!important}.px{padding-left:18px!important;padding-right:18px!important}
.top-left,.top-right{display:block!important;width:auto!important;text-align:left!important}.top-right{padding-top:8px!important}
.hero-number{width:56px!important;font-size:54px!important;line-height:58px!important}.hero-copy{padding-left:12px!important}
.hero-title{font-size:25px!important;line-height:32px!important}
.stat{padding:12px 6px!important}.stat-label{font-size:14px!important;line-height:21px!important}.stat-value{font-size:24px!important;line-height:30px!important}
.obj-title{font-size:20px!important;line-height:28px!important}
.object-type,.object-status{display:block!important;width:auto!important;text-align:left!important}.object-status{padding-top:10px!important}
.index-name,.index-status{display:block!important;width:auto!important;text-align:left!important}.index-name{padding-bottom:4px!important;border-bottom:0!important}.index-status{padding-top:3px!important}
.diff-table,.diff-table tbody{display:block!important;width:100%!important}.diff-table thead{display:none!important}
.diff-row{display:block!important;width:100%!important;border-top:1px solid #D7CCC1!important;font-size:0!important}
.diff-field,.diff-action{display:block!important;width:100%!important;box-sizing:border-box!important;border-top:0!important}
.diff-field{padding:12px 12px 5px!important}.diff-action{padding:3px 12px 10px!important}
.diff-before,.diff-after{display:inline-block!important;vertical-align:top!important;width:50%!important;box-sizing:border-box!important;border-top:0!important;padding:10px 12px 14px!important}
.mobile-label{display:block!important;font-size:14px!important;line-height:20px!important;font-weight:bold!important;margin-bottom:5px!important}
.meta-key,.meta-value{display:block!important;width:auto!important}.meta-key{border-bottom:0!important;padding-bottom:2px!important}.meta-value{padding-top:0!important}
