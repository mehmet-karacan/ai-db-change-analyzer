{% if obj.rows %}<table aria-label="{{ obj.type }} {{ obj.display_name }} önceki ve yeni değerler" border="0" cellpadding="0" cellspacing="0" class="diff-table" style="width:100%;table-layout:fixed;border-collapse:collapse;border-top:1px solid #D7CCC1;border-bottom:1px solid #D7CCC1;" width="100%">
<thead><tr><th align="left" bgcolor="#F3EEE7" scope="col" style="width:25%;padding:11px 12px;word-wrap:break-word;overflow-wrap:anywhere;font-size:14px;line-height:21px;font-weight:bold;background-color:#F3EEE7;color:#24211F;" valign="top" width="25%">Değişen alan</th><th align="left" bgcolor="#F3EEE7" scope="col" style="width:25%;padding:11px 12px;word-wrap:break-word;overflow-wrap:anywhere;font-size:14px;line-height:21px;font-weight:bold;background-color:#F3EEE7;color:#24211F;" valign="top" width="25%">Değişiklik</th><th align="left" bgcolor="#F3EEE7" scope="col" style="width:25%;padding:11px 12px;word-wrap:break-word;overflow-wrap:anywhere;font-size:14px;line-height:21px;font-weight:bold;background-color:#F3EEE7;color:#24211F;" valign="top" width="25%">Önceki değer</th><th align="left" bgcolor="#F3EEE7" scope="col" style="width:25%;padding:11px 12px;word-wrap:break-word;overflow-wrap:anywhere;font-size:14px;line-height:21px;font-weight:bold;background-color:#F3EEE7;color:#24211F;" valign="top" width="25%">Yeni değer</th></tr></thead>
<tbody>{% for fact in obj.rows %}<tr class="diff-row">
<th align="left" class="diff-field wrap" scope="row" style="width:25%;padding:12px;border-top:1px solid #D7CCC1;font-size:15px;line-height:23px;font-weight:normal;color:#24211F;word-wrap:break-word;overflow-wrap:anywhere;" valign="top" width="25%"><strong>{{ fact.field }}</strong><br/><span style="font-size:14px;color:#5F5954;">{{ fact.subject }}</span></th>
<td align="left" class="diff-action" style="width:25%;padding:12px;border-top:1px solid #D7CCC1;font-size:15px;line-height:23px;color:#24211F;word-wrap:break-word;overflow-wrap:anywhere;" valign="top" width="25%"><span class="mobile-label" style="display:none;mso-hide:all;">Değişiklik</span>{{ fact.change }}</td>
<td align="left" bgcolor="#FFFEFC" class="diff-before wrap" style="width:25%;padding:12px;border-top:1px solid #D7CCC1;font-size:15px;line-height:23px;background-color:#FFFEFC;color:#24211F;word-wrap:break-word;overflow-wrap:anywhere;" valign="top" width="25%"><span class="mobile-label" style="display:none;mso-hide:all;">Önceki değer</span>{{ fact.before }}</td><td align="left" bgcolor="#F3EEE7" class="diff-after wrap" style="width:25%;padding:12px;border-top:1px solid #D7CCC1;font-size:15px;line-height:23px;background-color:#F3EEE7;color:#24211F;word-wrap:break-word;overflow-wrap:anywhere;" valign="top" width="25%"><span class="mobile-label" style="display:none;mso-hide:all;">Yeni değer</span><strong>{{ fact.after }}</strong></td>
</tr>{% endfor %}</tbody></table>{% else %}<p style="font-size:15px;line-height:24px;color:#5F5954;">Önceki ve yeni alan değerleri güvenle ayrıştırılamadı. Kaynak farkı kaydı korunuyor.</p>{% endif %}
{% if obj.omitted_facts %}<p style="font-size:14px;line-height:22px;color:#5F5954;">{{ obj.omitted_facts }} alan bu e-postada gösterilmedi.</p>{% endif %}
