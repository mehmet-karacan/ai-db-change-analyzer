<tr><td class="px" style="padding:25px 34px;">
<h2 style="margin:0 0 12px;font-size:21px;line-height:29px;color:#24211F;">Karşılaştırma bilgisi</h2>
<table aria-label="Git karşılaştırma bilgisi" border="0" cellpadding="0" cellspacing="0" style="width:100%;table-layout:fixed;border-collapse:collapse;" width="100%">{% for row in comparison_rows %}<tr><th align="left" class="meta-key" scope="row" style="width:46%;padding:9px 14px 9px 0;border-bottom:1px solid #D7CCC1;font-size:14px;line-height:22px;font-weight:normal;color:#5F5954;" width="46%">{{ row.label }}</th><td class="meta-value" style="padding:9px 0;border-bottom:1px solid #D7CCC1;font-size:15px;line-height:23px;font-weight:bold;color:#24211F;">{{ row.value }}</td></tr>{% endfor %}</table>
<p style="margin:12px 0 0;font-size:13px;line-height:21px;color:#5F5954;">{% if synthetic %}Snapshot kimlikleri sentetiktir. {% endif %}Bu rapor canlı veritabanı doğrulaması değildir.{% if report_url %} <a href="{{ report_url }}" style="color:#24211F;text-decoration:underline;">Yetkili tam raporu aç</a>{% else %} Tam rapor bağlantısı yapılandırılmadı.{% endif %}</p>
</td></tr>