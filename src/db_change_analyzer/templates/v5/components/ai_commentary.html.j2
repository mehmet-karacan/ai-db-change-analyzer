{% if obj.checks %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td height="14" style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr><tr><td bgcolor="#EAF4FA" style="padding:15px 16px;border-left:3px solid #147EA4;background-color:#EAF4FA;color:#18283A;font-size:14px;line-height:23px;"><p style="margin:0 0 6px;font-size:14px;line-height:21px;font-weight:bold;color:#0B5F80;">Olası etki ve kontrol</p><p style="margin:0 0 5px;color:#36556E;">Değişen tanım aşağıdaki alanlarda inceleme gerektirebilir:</p>{% for check in obj.checks %}<p style="margin:5px 0 0;color:#18283A;">• {{ check }}</p>{% endfor %}<p style="margin:8px 0 0;font-size:13px;line-height:20px;color:#5C6B7A;">Bu bölüm kaynak farkına bağlı kontrol önerisidir; gerçek tüketiciler ve canlı çalışma etkisi bu karşılaştırmadan doğrulanmaz.</p></td></tr></table>{% endif %}
{% for comment in obj.comments %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td height="14" style="height:14px;line-height:14px;font-size:0;">&nbsp;</td></tr><tr><td bgcolor="#F6F0F8" style="padding:14px 16px;border-left:3px solid #694074;background-color:#F6F0F8;color:#18283A;font-size:15px;line-height:24px;"><p style="margin:0 0 5px;font-size:14px;line-height:21px;font-weight:bold;color:#694074;">{{ comment.label }}</p>{{ comment.text }}</td></tr></table>{% endfor %}
