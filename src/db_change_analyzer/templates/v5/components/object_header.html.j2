<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr>
<td class="object-type" align="left" valign="middle" style="font-size:14px;line-height:23px;color:#5C6B7A;word-wrap:break-word;overflow-wrap:anywhere;"><span style="color:#E92231;font-size:22px;line-height:27px;font-weight:bold;">{{ obj.number }}</span>&nbsp;&nbsp;<strong style="color:#18283A;">{{ obj.type }}</strong><br>{{ obj.type_label }}</td>
<td class="object-status" align="right" valign="top" style="text-align:right;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="display:inline-table;border-collapse:collapse;"><tr><td bgcolor="{{ obj.action.bg }}" style="padding:7px 11px;border:1px solid {{ obj.action.fg }};background-color:{{ obj.action.bg }};font-size:14px;line-height:21px;font-weight:bold;color:{{ obj.action.fg }};"><span aria-hidden="true">{{ obj.action.symbol }} </span>{{ obj.action.label }}</td></tr></table></td>
</tr></table>
<h3 id="{{ obj.anchor }}" class="obj-title wrap" style="margin:13px 0 6px;font-size:23px;line-height:31px;font-weight:bold;color:#18283A;word-wrap:break-word;overflow-wrap:anywhere;">{{ obj.display_name }}</h3>
<p style="margin:0 0 15px;font-size:15px;line-height:24px;color:#5C6B7A;">{{ obj.summary }}</p>
{% if obj.limited %}<p style="margin:0 0 14px;font-size:14px;line-height:23px;color:#5C6B7A;"><strong>? Sınırlı analiz.</strong> Yalnız doğrulanan alanlar gösterilir; diğer alanlar tamamlanmış sayılmaz.</p>{% endif %}
