<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><title>AI DB Analyzer · {{ headline }}</title></head>
<body style="margin:0;padding:0;background:#edf1f5;color:#243649;font-family:Arial,Helvetica,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#edf1f5"><tr><td align="center" style="padding:28px 12px">
<table role="presentation" width="720" cellpadding="0" cellspacing="0" style="width:100%;max-width:720px;background:#ffffff;border:1px solid #dce4eb;border-radius:12px;overflow:hidden">
<tr><td style="background:#17344e;padding:30px 34px;color:#ffffff">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td style="font-size:11px;letter-spacing:1.5px;font-weight:bold;color:#bed6e9">AI DB ANALYZER · {{ run.repository_id }}</td><td align="right"><span style="display:inline-block;padding:7px 11px;border-radius:15px;background:{{ quality_background }};color:{{ quality_foreground }};font-size:11px;font-weight:bold">{{ quality_label }}</span></td></tr></table>
<h1 style="font-size:25px;line-height:1.25;margin:22px 0 10px;font-weight:bold">{{ headline }}</h1>
<p style="font-size:14px;line-height:1.6;color:#dce9f3;margin:0">{{ summary_tr }}</p>
</td></tr>
<tr><td style="padding:24px 34px 6px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
<td width="33%" style="padding:0 7px 0 0"><div style="background:#f3f7fa;border:1px solid #e1e9ef;border-radius:8px;padding:15px"><div style="font-size:24px;color:#17344e;font-weight:bold">{{ counts.net_files }}</div><div style="font-size:11px;color:#607487;margin-top:4px">DEĞİŞEN DOSYA</div></div></td>
<td width="33%" style="padding:0 4px"><div style="background:#f3f7fa;border:1px solid #e1e9ef;border-radius:8px;padding:15px"><div style="font-size:24px;color:#17344e;font-weight:bold">{{ counts.net_known_objects }}</div><div style="font-size:11px;color:#607487;margin-top:4px">TANINAN NESNE</div></div></td>
<td width="33%" style="padding:0 0 0 7px"><div style="background:#f3f7fa;border:1px solid #e1e9ef;border-radius:8px;padding:15px"><div style="font-size:24px;color:#17344e;font-weight:bold">{{ counts.change_events }}</div><div style="font-size:11px;color:#607487;margin-top:4px">DEĞİŞİKLİK OLAYI</div></div></td>
</tr></table>
<h2 style="font-size:17px;margin:29px 0 8px;color:#17344e">Ne değişti?</h2>
{% if sequence_rows %}<p style="font-size:13px;line-height:1.55;color:#52677b;margin:0 0 14px">Kaynakta yalnız <strong>START WITH</strong> sayısı değişen sequence tanımları:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;border:1px solid #dce5eb">
<tr style="background:#e8f0f5;color:#334d63"><th align="left" style="padding:10px">SEQUENCE</th><th align="right" style="padding:10px">ÖNCE</th><th align="right" style="padding:10px">SONRA</th><th align="right" style="padding:10px">FARK</th></tr>
{% for row in sequence_rows %}<tr style="background:{{ '#ffffff' if loop.index is odd else '#f7fafc' }};border-top:1px solid #e5ecf1"><td style="padding:10px;word-break:break-word"><strong>{{ row.name }}</strong><br><span style="font-size:11px;color:#73869a">{{ row.schema }}</span></td><td align="right" style="padding:10px;white-space:nowrap">{{ row.before }}</td><td align="right" style="padding:10px;white-space:nowrap;font-weight:bold;color:#17603a">{{ row.after }}</td><td align="right" style="padding:10px;white-space:nowrap;color:#52677b">{{ row.delta }}</td></tr>{% endfor %}
</table>{% endif %}
{% for item in object_cards %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;border:1px solid #dce5eb;border-radius:7px"><tr><td style="padding:13px 15px"><div style="font-size:13px;font-weight:bold;color:#17344e">{{ item.name }} <span style="font-weight:normal;color:#71869a">· {{ item.schema }} · {{ item.object_type }}</span></div><div style="font-size:12px;line-height:1.5;color:#52677b;margin-top:6px">{{ item.summary }}</div></td></tr></table>{% endfor %}
{% if not sequence_rows and not object_cards %}<p style="font-size:13px;color:#52677b">Bu karşılaştırmada gösterilecek nesne farkı bulunmadı.</p>{% endif %}
{% if omitted_objects %}<p style="font-size:12px;color:#71869a">{{ omitted_objects }} ek nesnenin ayrıntısı tam raporda yer alır.</p>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:25px;background:#eaf3fa;border-left:4px solid #4a91bf"><tr><td style="padding:15px 17px;font-size:12px;line-height:1.6;color:#34556d"><strong>Etki ve risk notu</strong><br>{% if sequence_only %}Bu gözlem için kanıtlanmış bir operasyonel risk seviyesi atanmadı. Git kaynağındaki başlangıç sayısı, canlı veritabanındaki NEXTVAL değeri veya deployment sonucu değildir.{% else %}Olası etkiler kaynak kanıtıyla sınırlıdır; AI yorumu doğrulanmış operasyonel risk seviyesi değildir.{% endif %}</td></tr></table>
<h2 style="font-size:15px;color:#17344e;margin:28px 0 10px">Karşılaştırma bilgisi</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:12px;border-top:1px solid #e4ebf0"><tr><td style="padding:8px 0;color:#73869a;width:130px">Depo / dal</td><td style="padding:8px 0">{{ run.repository_id }} / {{ run.branch }}</td></tr><tr><td style="padding:8px 0;color:#73869a">Base → Target</td><td style="padding:8px 0;font-family:Consolas,monospace">{{ short_base }} → {{ short_target }}</td></tr><tr><td style="padding:8px 0;color:#73869a">Çalışma modu</td><td style="padding:8px 0">{{ run.mode }}</td></tr></table>
{% if report_url %}<p style="margin:23px 0 0"><a href="{{ report_url }}" style="display:inline-block;background:#176b99;color:#ffffff;text-decoration:none;padding:11px 17px;border-radius:6px;font-size:12px;font-weight:bold">Tam raporu aç</a></p>{% endif %}
</td></tr>
<tr><td style="padding:18px 34px 24px;background:#f7f9fb;border-top:1px solid #e3eaf0;font-size:11px;line-height:1.55;color:#71869a">{% for limitation in limitations %}{{ limitation }}{% if not loop.last %}<br>{% endif %}{% endfor %}<br>Bu rapor yalnız Git snapshot'ını değerlendirir; canlı veritabanı veya deployment onayı değildir.</td></tr>
</table></td></tr></table></body></html>
