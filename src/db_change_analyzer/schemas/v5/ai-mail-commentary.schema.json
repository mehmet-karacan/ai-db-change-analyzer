{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mail-commentary/1.1"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/statement"
        },
        {
          "type": "null"
        }
      ]
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      },
      "minItems": 0,
      "maxItems": 2
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      },
      "minItems": 0,
      "maxItems": 2
    },
    "recommended_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 0,
      "maxItems": 2
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "unit_id",
    "input_digest",
    "summary",
    "interpretations",
    "uncertainties",
    "recommended_checks"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI commentary 1.1: evidence-bound prose, no HTML, risk score or runtime metadata",
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360,
          "pattern": "^[^<>\\r\\n\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u2013\\u2014]+$"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "claim_kind": {
          "type": "string",
          "enum": [
            "change_restatement",
            "source_interpretation"
          ]
        }
      },
      "required": [
        "text_tr",
        "fact_ids",
        "evidence_ids",
        "claim_kind"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360,
          "pattern": "^[^<>\\r\\n\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u2013\\u2014]+$"
        },
        "context_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "limitation_code": {
          "type": "string",
          "enum": [
            "NO_LIVE_DB",
            "NO_RUNTIME_CONSUMERS",
            "DYNAMIC_SQL_UNRESOLVED",
            "PARSER_LIMIT",
            "SECRET_REDACTED",
            "AMBIGUOUS_IDENTITY",
            "MODEL_METADATA_UNREPORTED",
            "SOURCE_SCOPE_LIMIT"
          ]
        }
      },
      "required": [
        "text_tr",
        "context_evidence_ids",
        "limitation_code"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360,
          "pattern": "^[^<>\\r\\n\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u2013\\u2014]+$"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "check_code": {
          "type": "string",
          "enum": [
            "SOURCE_REFERENCES",
            "CALL_SIGNATURE",
            "COLUMN_CONTRACT",
            "QUERY_DEFINITION",
            "INDEX_DEFINITION",
            "SEQUENCE_DEFINITION",
            "DYNAMIC_SQL",
            "TRANSACTION_SOURCE",
            "EXCEPTION_SOURCE",
            "MANUAL_SOURCE_REVIEW"
          ]
        }
      },
      "required": [
        "text_tr",
        "fact_ids",
        "evidence_ids",
        "check_code"
      ]
    }
  }
}
