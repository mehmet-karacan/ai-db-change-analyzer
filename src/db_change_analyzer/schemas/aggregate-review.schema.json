{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregate model review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "aggregate-review/1.0" },
    "unit_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "input_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commentary_tr": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 100 }, "minItems": 1, "maxItems": 12 },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 }, "maxItems": 8 }
  },
  "required": ["schema_version", "unit_id", "input_digest", "commentary_tr", "evidence_ids", "limitations"]
}
